 {
  "id": "01_happy_path",
  "about": "Details read back and confirmed, one time offered, caller says yes, one booking.",
  "steps": [
   {
    "caller": "Hi, I'd like to book a cleaning. I'm Dana Whitfield, my number is 212 555 0147."
   },
   {
    "tool": "save_caller_details",
    "args": {
     "name": "Dana Whitfield",
     "phone": "212 555 0147"
    },
    "ok": true
   },
   {
    "caller": "Yes, that's right."
   },
   {
    "tool": "confirm_caller_details",
    "ok": true
   },
   {
    "caller": "Wednesday afternoon please."
   },
   {
    "tool": "list_slots",
    "args": {
     "day": "2026-11-18"
    },
    "ok": true
   },
   {
    "tool": "offer_slot",
    "args": {
     "slot_id": "2026-11-18T15:00"
    },
    "ok": true,
    "has": "Shall I book Wednesday 18 November at 3:00 PM Eastern time for you?"
   },
   {
    "caller": "Yes please."
   },
   {
    "tool": "book_appointment",
    "args": {
     "slot_id": "2026-11-18T15:00"
    },
    "ok": true,
    "has": "You're booked for Wednesday 18 November at 3:00 PM Eastern time"
   }
  ],
  "bookings": [
   {
    "slot": "2026-11-18T15:00",
    "name": "Dana Whitfield",
    "phone": "2125550147"
   }
  ]
 },
